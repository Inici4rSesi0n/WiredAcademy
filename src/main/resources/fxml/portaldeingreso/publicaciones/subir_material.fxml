<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.portaldeingreso.publicaciones.SubirMaterialController"
            styleClass="app-background">
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30px;">
            <HBox styleClass="crud-header" alignment="CENTER_LEFT">
                <Label styleClass="crud-title" text="Gestor de Publicaciones (CMS)" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNuevaPublicacion" text="+ Nueva Publicación" styleClass="boton-primario" onAction="#handleNuevaPublicacion" />
            </HBox>

            <!-- Repositorio (Tabla) -->
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaPublicaciones" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="250.0" />
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120.0" />
                        <TableColumn fx:id="colAsignatura" text="Asignatura" prefWidth="150.0" />
                        <TableColumn fx:id="colSemana" text="Semana" prefWidth="80.0" />
                        <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="150.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Formulario Lateral -->
    <right>
        <ScrollPane fx:id="scrollPaneFormulario" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormulario" styleClass="formulario-panel" spacing="15.0" prefWidth="400.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                
                <Label styleClass="formulario-title" text="Detalles de la Publicación" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                
                <Label text="Tipo de Publicación:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbTipo" styleClass="formulario-input" maxWidth="1.0E8" onAction="#handleTipoCambiado" />
                
                <Label text="Título:" styleClass="formulario-label" />
                <TextField fx:id="txtTitulo" promptText="Ej. Práctica Calificada 1" styleClass="formulario-input" />
                
                <Label text="Descripción:" styleClass="formulario-label" />
                <TextArea fx:id="txtDescripcion" promptText="Instrucciones o detalles..." styleClass="formulario-input" prefHeight="80.0" wrapText="true"/>
                
                <VBox fx:id="vboxAsignatura" spacing="5.0">
                    <Label text="Asignatura:" styleClass="formulario-label" />
                    <ComboBox fx:id="cmbAsignatura" styleClass="formulario-input" maxWidth="1.0E8" />
                </VBox>

                <VBox fx:id="vboxSemana" spacing="5.0">
                    <Label text="Semana (Opcional):" styleClass="formulario-label" />
                    <TextField fx:id="txtSemana" promptText="Ej. 1" styleClass="formulario-input" />
                </VBox>

                <VBox fx:id="vboxFechaLimite" spacing="5.0">
                    <Label text="Fecha Límite (Opcional):" styleClass="formulario-label" />
                    <DatePicker fx:id="dateFechaLimite" styleClass="formulario-input" maxWidth="1.0E8" />
                </VBox>

                <Label text="Archivo Adjunto (Opcional):" styleClass="formulario-label" />
                <Button fx:id="btnAdjuntar" text="📎 Seleccionar Archivo" styleClass="boton-secundario" maxWidth="1.0E8" onAction="#handleAdjuntarArchivo" />
                <Label fx:id="lblArchivoSeleccionado" text="Ningún archivo seleccionado" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>

                <Region VBox.vgrow="ALWAYS" />
                
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelar" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelar" prefWidth="120.0" />
                    <Button fx:id="btnGuardar" text="Publicar" styleClass="boton-primario" onAction="#handleGuardar" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
