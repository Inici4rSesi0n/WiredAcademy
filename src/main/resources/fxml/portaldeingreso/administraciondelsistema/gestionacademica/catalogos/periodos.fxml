<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentacion.controlador.portaldeingreso.administraciondelsistema.gestionacademica.catalogos.PeriodosController">
    
    <center>
        <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS" style="-fx-padding: 10px 15px 15px 15px;">
            <TableView fx:id="tablaPeriodos" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNumPeriodo" text="N°" prefWidth="50.0" />
                    <TableColumn fx:id="colNombrePeriodo" text="Nombre" prefWidth="150.0" />
                    <TableColumn fx:id="colFechaInicio" text="Fecha Inicio" prefWidth="120.0" />
                    <TableColumn fx:id="colFechaFin" text="Fecha Fin" prefWidth="120.0" />
                    <TableColumn fx:id="colEstadoPeriodo" text="Estado" prefWidth="100.0" />
                    <TableColumn fx:id="colAccionesPeriodo" text="Acciones" prefWidth="160.0" />
                </columns>
            </TableView>
        </VBox>
    </center>
    <right>
        <ScrollPane fx:id="scrollPaneFormulario" visible="false" managed="false" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox fx:id="panelFormularioPeriodo" styleClass="formulario-panel" spacing="15.0" prefWidth="400.0">
                <padding><Insets top="30.0" right="30.0" bottom="30.0" left="30.0" /></padding>
                <Label styleClass="formulario-title" text="Datos del Periodo" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                <Separator styleClass="formulario-separator" />
                <Label text="Nombre:" styleClass="formulario-label" />
                <TextField fx:id="txtNombrePeriodo" promptText="Ej. 2026-I" styleClass="formulario-input" />
                <Label text="Fecha Inicio:" styleClass="formulario-label" />
                <DatePicker fx:id="dateFechaInicio" promptText="YYYY/MM/DD" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Label text="Fecha Fin:" styleClass="formulario-label" />
                <DatePicker fx:id="dateFechaFin" promptText="YYYY/MM/DD" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Label text="Estado:" styleClass="formulario-label" />
                <ComboBox fx:id="cmbEstadoPeriodo" promptText="Seleccione un estado" styleClass="formulario-input" maxWidth="1.0E8"/>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 20 0 0 0;">
                    <Button fx:id="btnCancelarPeriodo" text="Cancelar" styleClass="boton-morado-suave" onAction="#handleCancelarPeriodo" prefWidth="120.0" />
                    <Button fx:id="btnGuardarPeriodo" text="Guardar" styleClass="boton-primario" onAction="#handleGuardarPeriodo" prefWidth="120.0" />
                </HBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
