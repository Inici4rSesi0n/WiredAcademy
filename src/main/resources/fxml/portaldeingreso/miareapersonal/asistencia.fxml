<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.portaldeingreso.miareapersonal.AsistenciaController"
            styleClass="app-background">
    <center>
        <VBox spacing="20.0" style="-fx-padding: 20px;">
            <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="crud-header">
                <Label text="Fecha:" styleClass="formulario-label"/>
                <DatePicker fx:id="dateAsistencia" styleClass="formulario-input" prefWidth="200.0"/>
            </HBox>
            <VBox styleClass="tabla-wrapper" VBox.vgrow="ALWAYS">
                <TableView fx:id="tablaAsistencia" styleClass="seccion-tabla" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colNombreAsistencia" text="Estudiante" prefWidth="300.0" />
                        <TableColumn fx:id="colAccionesAsistencia" text="Registrar Asistencia" prefWidth="250.0" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
