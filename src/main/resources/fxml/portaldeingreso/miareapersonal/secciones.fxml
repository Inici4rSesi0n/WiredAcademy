<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.portaldeingreso.miareapersonal.SeccionesController"
            styleClass="app-background">
    <top>
        <HBox styleClass="crud-header" alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 20px;">
            <Button text="← Volver a Mis Cursos" styleClass="boton-morado-suave" onAction="#handleVolver" />
            <Label fx:id="lblTituloAsignatura" styleClass="crud-title" text="Secciones" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="flowPaneSecciones" hgap="20.0" vgap="20.0" style="-fx-padding: 20px;" />
        </ScrollPane>
    </center>
</BorderPane>
