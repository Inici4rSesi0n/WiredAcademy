<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="presentacion.controlador.portaldeingreso.miareapersonal.PublicacionesPanelController"
            styleClass="app-background">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;" styleClass="app-background">
            <VBox fx:id="vboxPublicaciones" spacing="15.0" style="-fx-padding: 20px;">
                <Label fx:id="lblVacio" text="No hay publicaciones disponibles." style="-fx-text-fill: #64748B; -fx-font-style: italic; -fx-font-size: 14px;" visible="false" managed="false"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
